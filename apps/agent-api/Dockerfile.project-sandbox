FROM node:24-alpine
RUN apk add --no-cache python3 py3-pip php php-phar composer git coreutils findutils util-linux
RUN npm install -g --prefix /opt/npati-package-managers --no-audit --no-fund pnpm@10 yarn@1.22.22
ENV PATH="/opt/npati-package-managers/bin:${PATH}"
RUN pnpm --version && yarn --version
RUN command -v pip >/dev/null || ln -s "$(command -v pip3)" /usr/local/bin/pip
RUN addgroup -g 10001 sandbox && adduser -D -u 10001 -G sandbox sandbox
USER 10001:10001
WORKDIR /workspace
CMD ["sleep", "infinity"]