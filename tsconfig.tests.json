{
  // Type gate for the test suites the repository keeps type-clean.
  //
  // `npm run typecheck` only walks each workspace's own tsconfig (`packages/*/src`, `apps/*/src`), so
  // `tests/**` was never typechecked by any run — which is how the errors fixed in C13 (a missing export,
  // stale literal shapes, `ContextType` drift) stayed invisible in CI while the IDE kept showing them.
  //
  // `tests/**` as a whole still carries a pre-existing backlog of type errors in other files
  // (451 diagnostics across ~100 suites at the time of writing), so this gate lists the suites that are
  // clean today and grows as the backlog is paid down. It must never be made to pass with `as any`,
  // `@ts-ignore` or a skipped file.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    // C15: the CLI (`packages/cli`) is plain ESM JavaScript with JSDoc types, checked by its own
    // `packages/cli/tsconfig.json` with `checkJs`. This project has to be allowed to *read* a `.js`/`.mjs` module
    // at all before it can use the types that project already validates; without `allowJs` every import from
    // `packages/cli` is `TS7016` and the suite would have to re-declare the CLI's types by hand — a second copy
    // of them, which is exactly the drift this repository's guards exist to prevent.
    "allowJs": true
  },
  "include": [
    "tests/coding-agent-async-process.test.ts",
    "tests/coding-agent-async-completions.test.ts",
    "tests/coding-agent-async-process-docker.test.ts",
    "tests/coding-agent-async-inbox.test.ts",
    "tests/coding-agent-async-inbox-postgres.test.ts",
    "tests/coding-agent-c6-eval.test.ts",
    "tests/coding-agent-c13-capability-catalog-audit.test.ts",
    "tests/coding-agent-c14-attack-catalogue.test.ts",
    "tests/coding-agent-c14-ci-and-lint-gates.test.ts",
    "tests/coding-agent-c14-eval-metrics-and-profiles.test.ts",
    "tests/coding-agent-c14-gate-mutation-sensitivity.test.ts",
    "tests/coding-agent-c14-known-failures.test.ts",
    "tests/coding-agent-c14-metrics-aggregation.test.ts",
    "tests/coding-agent-c14-model-profile-fallback.test.ts",
    "tests/coding-agent-c14-model-profile-flags.test.ts",
    // G1 (item 3): the branch-mutation matrix and the guard that keeps it honest, plus the verdict reader of the
    // decoy-branch runner. Added here together with the suite itself, so the gate's own file is type-clean by
    // construction rather than by hope — the same rule every other suite in this list follows.
    "tests/coding-agent-c14-mutation-branch-controls.test.ts",
    "tests/coding-agent-c14-redteam-command-output-injection.test.ts",
    "tests/coding-agent-c14-redteam-fork-bomb.test.ts",
    "tests/coding-agent-c14-redteam-new-channels.test.ts",
    "tests/coding-agent-c14-redteam-path-and-zip-slip.test.ts",
    "tests/coding-agent-c14-redteam-resource-exhaustion.test.ts",
    "tests/coding-agent-c14-replay-cassette-engine.test.ts",
    "tests/coding-agent-c14-replay-cassette-store.test.ts",
    // C14 (owner decision 4): the SLO calibration and the anomaly detector it configures. Added to this gate
    // with the suite itself, so the new file is type-clean by construction rather than by hope.
    "tests/coding-agent-c14-slo-calibration.test.ts",
    // C14 (post-step cleanup): the source guard over the phase order and the security-gate suite count. It is
    // added here together with the suite itself, for the same reason.
    "tests/coding-agent-c14-policy-phase-and-gate-size-guard.test.ts",
    // R1-A (section A, items 1–5): the limits-and-quotas suites. Added here together with the suites themselves,
    // so the gate's own new files are type-clean by construction rather than by hope — the same rule every other
    // suite in this list follows. Both are hermetic (no Postgres, no Docker, no port).
    "tests/coding-agent-r1a-limits-and-quotas.test.ts",
    "tests/coding-agent-r1a-sandbox-quotas.test.ts",
    // C15 (owner decisions 2 and 3): the run-start route, the CLI token boundary and the approvals/stream halves.
    // Added here together with the suite itself, so the gate's own file is type-clean by construction rather than
    // by hope — the same rule every other suite in this list follows.
    "tests/coding-agent-c15-cli-run-start.test.ts",
    // C15 (mounted local folder): the provider/resolver half and the sandbox/runner half. Added here together
    // with the suites themselves, so they are type-clean by construction rather than by hope.
    "tests/coding-agent-c15-mount-sandbox.test.ts",
    "tests/coding-agent-c15-mounted-workspace.test.ts",
    // G1 (item 2 and 3): the two suites of the **database** gate, added here together with the suites
    // themselves — the same rule every other suite in this list follows. They are skipped by `npm test` (they
    // require `DATABASE_URL` and the `NPATI_SECURITY_GATE_DB=1` marker their gate scripts set), and the type gate
    // is what keeps their connection/cleanup code honest while they cannot run on a machine without PostgreSQL.
    "tests/coding-agent-c1c-audit-postgres.test.ts",
    "tests/coding-agent-g1-migrations-postgres.test.ts",
    // G1 (item 5): the clean-clone prerequisite suite, added here together with the suite itself — the same rule
    // every other suite in this list follows. It generates datasets into temporary trees, so the type gate is
    // what keeps its path handling honest.
    "tests/coding-agent-g1-clean-clone-prerequisites.test.ts",
    // G1 (production CrashLoop): the production-key timing suite, added here together with the suite itself — the
    // same rule every other suite in this list follows. It transpiles and evaluates a copy of `crypto-vault.ts`
    // in memory, so the type gate is what keeps that in-memory evaluation honest.
    "tests/coding-agent-g1-crypto-vault-production-key-timing.test.ts",
    "tests/control-plane-ui-and-revisions.test.ts",
    "tests/full-capability-regression.test.ts",
    "tests/invariants-and-anti-patterns.test.ts",
    "tests/manual-product-e2e-web.test.ts",
    "tests/phase13-upgrade-gate-expanded.test.ts",
    "tests/phase14-final-production-acceptance.test.ts",
    "tests/production-acceptance.test.ts"
  ]
}
