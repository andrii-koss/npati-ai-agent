NPATI_ENV=development
NPATI_AGENT_API_PORT=3001
NPATI_COMPANY_RUN_TIMEOUT_MS=120000
NPATI_COMPANY_WORKER_CONCURRENCY=2
NPATI_COMPANY_RUN_LEASE_MS=180000
NPATI_COMPANY_RECOVERY_INTERVAL_MS=30000
NPATI_WEB_PORT=3000
NPATI_WEB_ORIGIN=http://localhost:3000

# Central private object storage. Replace local-development values before deployment.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ROOT_USER=npati-local-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_ACCESS_KEY=npati-local-admin
MINIO_SECRET_KEY=replace-with-a-long-random-secret
MINIO_CONSOLE_PORT=9001
MINIO_OPERATION_TIMEOUT_MS=15000
MINIO_STREAM_IDLE_TIMEOUT_MS=30000
MINIO_STREAM_TOTAL_TIMEOUT_MS=300000
NPATI_STORAGE_RECONCILE_INTERVAL_MS=21600000
NPATI_STORAGE_ORPHAN_GRACE_MS=86400000
NPATI_STORAGE_RECONCILE_LEASE_MS=1800000
NPATI_STORAGE_RECONCILE_PAGE_SIZE=250

OMNIROUTE_BASE_URL=http://omniroute:20128
OMNIROUTE_API_KEY=npati-agent-internal-local
OMNIROUTE_MANAGEMENT_PASSWORD=
ARENA_ELO_SYNC_ENABLED=false
OMNIROUTE_TRANSCRIPTION_MODEL=openai/whisper-1
OMNIROUTE_TTS_MODEL=openai/gpt-4o-mini-tts
OMNIROUTE_EMBEDDING_MODEL=
OMNIROUTE_RERANK_MODEL=
# Configure one native OmniRoute rerank provider, then set OMNIROUTE_RERANK_MODEL.
JINA_AI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
OMNIROUTE_VISION_MODEL=openai/gpt-5.6-luna
OMNIROUTE_DASHBOARD_PORT=20128
OMNIROUTE_API_PORT=20129
OMNIROUTE_LIVE_WS_PORT=20132

NPATI_HUB_BASE_URL=
NPATI_HUB_API_KEY=
NPATI_BACKEND_URL=https://www.npati.com
NPATI_JWT_SECRET=
NPATI_AUTH_STRICT=true
NPATI_AGENT_PUBLIC_DOMAIN=http://localhost:3000
# Public HTTPS origin that routes /api/v1/integrations/telegram/* to agent-api.
# Telegram webhooks are configured automatically only when this value is set.
NPATI_MESSAGING_WEBHOOK_BASE_URL=
NPATI_AGENT_VERSION=0.1.0
NPATI_DEPLOYMENT_TYPE=self_hosted
# Official npati_hosted deployments only; never commit the real value.
NPATI_HOSTED_REGISTRATION_TOKEN=
# Compatibility only. Keep false for self-hosted installations so passwords are entered only on NPATI domains.
NPATI_ALLOW_LEGACY_PASSWORD_AUTH=false

CRAWL4AI_BASE_URL=http://crawler:11235
CRAWL4AI_VERSION=0.9.2
CRAWL4AI_API_TOKEN=replace-with-a-long-random-local-token
CRAWL4AI_SECRET_KEY=replace-with-a-long-random-local-secret
BROWSER_USE_API_KEY=
BROWSER_USE_MODEL=bu-2-0
NPATI_BROWSER_INTERNAL_TOKEN=replace-with-a-long-random-browser-worker-token
NPATI_BROWSER_MAX_RETRIES=2
NPATI_CRAWLER_PAGE_TIMEOUT_MS=45000

WEB_RESEARCH_MAX_SEARCH_RESULTS=10
WEB_RESEARCH_MAX_COMPETITORS=5
WEB_RESEARCH_MAX_PAGES_PER_SITE=10
WEB_RESEARCH_MAX_CRAWL_DEPTH=2
WEB_RESEARCH_TIMEOUT_SECONDS=45
WEB_RESEARCH_MAX_CONCURRENT_JOBS=2
WEB_RESEARCH_CACHE_TTL_SECONDS=600
WEB_RESEARCH_MAX_CONTENT_CHARACTERS=80000
WEB_RESEARCH_PER_DOMAIN_DELAY_MS=750

# Data Studio project databases.
# docker-compose.yml (local development): opt-in with "docker compose --profile data-studio up -d".
# docker-compose.dokploy.yml (single-host production): postgres-projects always starts, so only the
# password below is required.
# Generate a password with: openssl rand -hex 32
NPATI_PROJECTS_POSTGRES_ADMIN_USER=npati_projects_admin
NPATI_PROJECTS_POSTGRES_ADMIN_PASSWORD=
# Snapshots older than this are pruned; the same window delays the purge of a deleted DataBackend.
NPATI_PROJECTS_SNAPSHOT_RETENTION_DAYS=30
# Where pg_dump files are written. Mount this path on a separate volume in production.
NPATI_PROJECTS_SNAPSHOT_DIR=/app/project-snapshots
NPATI_DATA_MAX_COLLECTIONS=50
NPATI_DATA_MAX_FIELDS=100
NPATI_DATA_MAX_ROWS=100
NPATI_DATA_MAX_QUERIES_PER_MINUTE=600
NPATI_DATA_MAX_DATABASE_BYTES=1000000000
NPATI_DATA_MAX_CONNECTIONS=10
# Automatic backups: prod every 24h by default, dev disabled (0). The tick decides how often
# the scheduler checks whether a snapshot is due; set NPATI_DATA_BACKUP_DISABLED=true to stop it.
NPATI_DATA_BACKUP_INTERVAL_MINUTES=1440
NPATI_DATA_BACKUP_KEEP=7
NPATI_DATA_BACKUP_TICK_SECONDS=300
# Rows per collection copied when a promote explicitly asks for dev data (withData).
NPATI_PROMOTE_DATA_MAX_ROWS=500
# Public HTTPS base URL of the NPATI Project API, used by sandbox preview apps.
# Set the same dedicated host in NPATI_SANDBOX_ALLOWED_HOSTS on the sandbox runner.
NPATI_PROJECT_API_PUBLIC_URL=
# Optional: path to the Project client SDK source that is vendored into Project workspaces.
# The agent-api image ships it at /opt/npati-project-sdk/index.ts, which is the default.
NPATI_PROJECT_CLIENT_PATH=

# --- Coding Agent (C1) -------------------------------------------------------------------
# Code projects and code sessions exist, but the agent itself is dark until the feature-flag step
# (C1a). These limits are configuration with the plan defaults; override only to tune a deployment.
NPATI_CODE_MAX_STEPS=40
NPATI_CODE_MAX_RUN_MINUTES=30
NPATI_CODE_TOOL_OUTPUT_CHARS=30000
NPATI_CODE_READ_FILE_LINES=2000
NPATI_CODE_READ_FILE_BYTES=1048576
NPATI_CODE_COMMAND_TIMEOUT_MS=120000
NPATI_CODE_INSTALL_TIMEOUT_MS=600000
NPATI_CODE_PARALLEL_READONLY=8
NPATI_CODE_EDIT_REPAIR_ATTEMPTS=2
# C9: repair rounds allowed after a failed verification (the run stops, it does not loop forever).
NPATI_CODE_REPAIR_LOOP=3
# C9: scope-guard threshold — a warning, never a block, when one run changes more files than this.
NPATI_CODE_MAX_CHANGED_FILES=25
# C9 (requirement 4): fix iterations allowed after the single self-review pass. Clamped to 1: a deployment may
# turn the fix iteration off, it may never add a second one.
NPATI_CODE_SELF_REVIEW_FIX_ITERATIONS=1
# Step 4: the adaptive rule may skip the model review only for a verified, presentation-only change (and only when
# no repair, test-integrity or scope warning is present). Set to false to review every change.
NPATI_CODE_SELF_REVIEW_ADAPTIVE=true
NPATI_CODE_CONTEXT_COMPRESSION_RATIO=0.75
NPATI_CODE_SUBAGENT_DEPTH=1
NPATI_CODE_SUBAGENT_PARALLELISM=4
NPATI_CODE_FLAG_PROPAGATION_SECONDS=30
NPATI_CODE_RUN_HEARTBEAT_MS=15000
NPATI_CODE_RUN_LEASE_MS=60000
NPATI_CODE_TOOL_NO_PROGRESS_MS=300000
NPATI_CODE_REAPER_INTERVAL_MS=60000
NPATI_CODE_MIN_PACKAGE_AGE_DAYS=7
NPATI_CODE_MAX_IMAGE_AGE_DAYS=14
NPATI_CODE_MAX_REDIRECTS=5
NPATI_CODE_TOOL_RESULT_RETENTION_DAYS=30
NPATI_CODE_TRANSCRIPT_RETENTION_DAYS=90

# --- C10: code-run queue, background runs and sandbox retention ---------------------------
# Concurrency of **code runs** (not model calls) per user and per Company. Both caps are enforced
# independently and each value is clamped to a hard ceiling, so a typo cannot remove the limit.
# R1 (section A, item 1) start values: 2 per user, 5 per Company (was 4 before R1).
NPATI_CODE_RUN_MAX_CONCURRENT_PER_USER=4
NPATI_CODE_RUN_MAX_CONCURRENT_PER_COMPANY=5
# How long a run may wait for a free slot before it is refused with `queue_timeout` (429 + retry-after).
NPATI_CODE_RUN_QUEUE_TIMEOUT_MS=120000
# How many runs may wait at once across all tenants before new tickets are refused.
# R1 (section A, item 3) start value: 50 (was 200 before R1).
NPATI_CODE_RUN_QUEUE_MAX_DEPTH=50

# --- R1 (section A, items 1 and 2): run rate limits, budgets ------------------------------
# Periodic limit on **run starts** (not concurrent runs), per user and per Company, over a sliding
# window. This is a limiter of its own: it is deliberately NOT the Company/Chat HTTP tier limiter
# (route-guard-tiers.ts), because a run start is paid for by the Company and holds a sandbox. A run
# that is refused is answered with 429 + retry-after equal to the window's own estimate. Values are
# clamped (ceiling: 1000 per user, 10000 per Company, 24 h window), so a typo cannot remove the limit.
NPATI_CODE_RUN_RATE_LIMIT_PER_USER_PER_PERIOD=30
NPATI_CODE_RUN_RATE_LIMIT_PER_COMPANY_PER_PERIOD=120
NPATI_CODE_RUN_RATE_LIMIT_PERIOD_MS=3600000
# Budget of one code-run session (the per-run allowance the runner checks before every model call).
# Total input+output tokens across tool turns; local/self-hosted default is 500000.
# Hosted default remains 100000. An explicit value overrides either default.
NPATI_CODE_RUN_MAX_TOKENS=500000
NPATI_CODE_RUN_MAX_COST_USD=1.0
# R1 A.2: daily token and cost budgets, per user and per Company, enforced through the same
# A2AQuotaManager accounting as the session budget (there is no second ledger). The keys carry the UTC
# date, so a new day is a new, empty allowance. A run that would breach one is stopped with
# `budget_exhausted` and an explicit message; 80 % and 100 % crossings are recorded as Coding Agent
# Activity events (`budget_threshold`).
NPATI_CODE_RUN_DAILY_MAX_TOKENS_PER_USER=2000000
NPATI_CODE_RUN_DAILY_MAX_COST_USD_PER_USER=20
NPATI_CODE_RUN_DAILY_MAX_TOKENS_PER_COMPANY=10000000
NPATI_CODE_RUN_DAILY_MAX_COST_USD_PER_COMPANY=100

# --- R1 (section A, item 4): sandbox resource quotas and host admission -------------------
# Per-sandbox ceilings. R1 start values: 2 vCPU, 4 GB RAM, 10 GB disk, 512 pids (before R1 the runner
# defaulted to 1 vCPU, 1536m, 1536 MiB and 128 pids, and the four keys below were undocumented).
# NPATI_SANDBOX_MEMORY_MB (integer megabytes) wins over the Docker-string NPATI_SANDBOX_MEMORY.
# Shared OSS runtime: total limits for all project processes in one container.
# Requires Linux Landlock ABI >= 6 (normally Linux 6.12+) and container NET_ADMIN.
NPATI_PROJECT_RUNTIME_CPU=4
# Execution architecture is separate from NPATI_SANDBOX_RUNNER_MODE (transport).
# Local/self-hosted Compose pins shared; explicitly hosted/isolated profiles pin isolated.
# NPATI_PROJECT_RUNTIME_MODE=shared
NPATI_PROJECT_RUNTIME_MEMORY=4g
# The following per-sandbox limits apply to the retained isolated Docker provider.
NPATI_SANDBOX_CPU=2
NPATI_SANDBOX_MEMORY=4096m
NPATI_SANDBOX_MEMORY_MB=
NPATI_SANDBOX_DISK_BYTES=10737418240
NPATI_SANDBOX_PIDS=512
# Aggregate ceilings for one Company: the parallel-sandbox cap plus the total CPU, memory, disk and
# pids its sandboxes may hold at once. Start values are five sandboxes and their sum.
NPATI_SANDBOX_MAX_PER_COMPANY=5
NPATI_SANDBOX_MAX_CPU_PER_COMPANY=10
NPATI_SANDBOX_MAX_MEMORY_MB_PER_COMPANY=20480
NPATI_SANDBOX_MAX_DISK_BYTES_PER_COMPANY=53687091200
NPATI_SANDBOX_MAX_PIDS_PER_COMPANY=2560
# Host admission control: no **new sandbox** is created while the host is above this CPU usage or below
# this share of free memory. It gates sandbox creation only — it is never applied to Company runs.
# A value of 0 is legal ("refuse everything"), so a misconfiguration fails closed rather than open.
NPATI_HOST_ADMISSION_MAX_CPU_PERCENT=80
NPATI_HOST_ADMISSION_MIN_FREE_MEMORY_PERCENT=15
# How long a host reading is reused before the next sandbox decision samples the host again (0 = always).
NPATI_HOST_ADMISSION_SAMPLE_TTL_MS=5000

# C10 item 7: a sandbox idle for longer than this is destroyed by the retention sweep (the idle map and the
# provider's own last-activity timestamp both bound it). Never clamped below NPATI_SANDBOX_IDLE_MS: retention
# destroys, so it can never be configured to fire the moment a sandbox stops.
NPATI_SANDBOX_RETENTION_MS=604800000

# --- Tamper-evident audit log (C1c) ------------------------------------------------------
# The journal is append-only (DB trigger) and hash-chained per company. Anchors are written daily to
# a signed file outside the Core database, so a full rewrite is still detectable.
NPATI_AUDIT_ANCHOR_DIR=
# Optional separate HMAC key for anchors; falls back to NPATI_ENCRYPTION_KEY.
NPATI_AUDIT_ANCHOR_KEY=
NPATI_AUDIT_VERIFY_INTERVAL_MS=21600000
NPATI_AUDIT_ANCHOR_INTERVAL_MS=3600000
# Retention of audit metadata (ids, hashes, redacted metadata only); R1 implements the pruning.
NPATI_AUDIT_RETENTION_DAYS=365
# When true (default) a detected chain break blocks new privileged audit writes until investigation.
NPATI_AUDIT_BLOCK_ON_BREAK=true
# Workspace used by background jobs (chain verifier, anchors) when there is no user context.
NPATI_WORKSPACE_ID=

# --- Coding Agent feature flags (C1a) ----------------------------------------------------
# The Coding Agent is dark by default: everything stays off until an owner/admin enables
# coding_agent.enabled (global or per company) in Settings -> Code -> Feature flags.
# Flag cache TTL in milliseconds; keep it at or below 30000 so a kill switch acts quickly.
NPATI_CODE_FLAG_CACHE_TTL_MS=15000
# Promoting a flag stage beyond "internal" (allowlist/percent/ga) is refused until G1 and R1 pass;
# set this to true only after those gates are signed off.
NPATI_ALLOW_PRE_GATE_ROLLOUT=false
# Automatically disable the Coding Agent globally when a security event is detected (for example a
# broken audit chain). The change is audited and the owner sees the new state in the UI.
NPATI_CODE_AUTO_DISABLE_ON_AUDIT_BREAK=true

# --- Sandbox image supply chain (C1b) ----------------------------------------------------
# Declarative image catalog: every sandbox image must be referenced as repo@sha256:<64hex>.
NPATI_SANDBOX_IMAGE_CATALOG=docker/sandbox/images.json
# Development only: allows locally built images. They stay "unverified" and are refused whenever a
# production flag is enabled for the company. Never enable this in production.
NPATI_SANDBOX_ALLOW_UNVERIFIED_IMAGES=false
# Optional seccomp profile passed to `docker run --security-opt seccomp=...`.
NPATI_SANDBOX_SECCOMP_PROFILE=
# cosign identity/issuer expected for a signed sandbox image; without them no signature verifier is
# configured and every image is denied (fail closed).
NPATI_SANDBOX_SIGNATURE_IDENTITY=
NPATI_SANDBOX_SIGNATURE_ISSUER=https://token.actions.githubusercontent.com

# --- Sandbox commands and secret leases (C4) ---------------------------------------------
# A secret lease is scoped to one tool call: the value is delivered to that single process only,
# never written into the persistent shell environment and never inherited by the next call. Without an
# audit journal no lease is issued (fail closed).
# Hard ceiling for a lease; it is also clamped to the tool-call timeout.
NPATI_CODE_SECRET_LEASE_MAX_TTL_MS=120000
NPATI_CODE_SECRET_LEASE_TTL_MS=120000
# How often expired leases are revoked.
NPATI_CODE_SECRET_LEASE_REAPER_MS=15000
# tmpfs directory inside the sandbox used for one-call secret files.
NPATI_CODE_SECRET_TMPFS_DIR=/run/npati-secrets
# Credential ids or labels that may be leased even though their `environment` is `unknown`.
# This is ONLY an administrative override: it additionally requires an owner/admin actor and is
# written to the tamper-evident audit journal (`secret_lease.override`) before the lease exists.
# A `production` credential can never be leased, with or without an entry here.
NPATI_CODE_SECRET_LEASE_ALLOWED_IDS=
NPATI_CODE_SECRET_LEASE_ALLOWED_LABELS=
# Ring buffer size per background process (log lines kept for `code.shell.process.logs`).
NPATI_CODE_PROCESS_LOG_LINES=2000
# Whether the sandbox actually enforces the egress allowlist (proxy/firewall, DNS/IP re-validation
# after resolution and redirects).
#
# C4b decision: this flag is ADVISORY ONLY. `true` does NOT authorize anything by itself — the sandbox
# **runner** is the authoritative component for network enforcement (it owns the Docker daemon), and it
# proves enforcement on every freshly created run network (egress proxy health, no direct egress from the
# network, no DNS bypass). The API asks the runner through the authenticated `POST /v1/readiness` endpoint
# and refuses network-dependent work with `network_enforcement_unavailable` (503) when the proof is missing
# or fails. `false` is the operator kill switch: the agent never claims enforcement, so network commands
# stay refused.
NPATI_SANDBOX_EGRESS_ENFORCED=false
# How long the API caches the runner readiness verdict (milliseconds). Clamped to at most 30000 so a stale
# "ready" answer cannot outlive the check by much.
NPATI_SANDBOX_RUNNER_READINESS_TTL_MS=15000
# Timeout for one runner readiness request (milliseconds); a timeout counts as "not ready".
NPATI_SANDBOX_RUNNER_READINESS_TIMEOUT_MS=4000
# How long a successful/failed readiness proof is cached before it is re-run (milliseconds).
NPATI_SANDBOX_EGRESS_PROBE_TTL_MS=60000
# Pinning cache for validated DNS answers used by the egress proxy (milliseconds); never longer than
# the DNS record's own TTL. Kept short so a rebinding answer cannot be reused.
NPATI_SANDBOX_EGRESS_DNS_TTL_MS=30000
# Maximum redirect hops for plain HTTP through the proxy; every hop is re-validated (host, resolution,
# address, port, scheme).
NPATI_SANDBOX_EGRESS_MAX_REDIRECTS=5
# Comma-separated hostname allowlist of the egress proxy. Exact names, or `*.example.com` which matches
# exactly one label. IP literals are never allowed, in any encoding. Denials are logged as structured
# `egress_denied` JSON; set NPATI_EGRESS_AUDIT_HOOK to an internal collector to mirror them
# (TODO(C5a): write allowlist changes to the AuditLog).
#
# C4b: the authoritative policy lives in `apps/agent-api/src/egress-allowlist.ts`. The provider and the
# runner take the default from there, so it is never duplicated as a string literal:
#   install phase -> exactly the approved official registries (index.crates.io, pypi.org, ...)
#   run phase     -> EMPTY by default, i.e. deny all; git hosts are never implicit
# Extend it additively through the two variables below (validated; wildcards only as `*.domain.tld`).
NPATI_SANDBOX_EGRESS_ALLOWLIST_INSTALL=
NPATI_SANDBOX_EGRESS_ALLOWLIST_RUN=
# Raw override for the proxy's `ALLOWED_HOSTS`. Prefer the two variables above; when set, this value is
# passed through verbatim and replaces the resolved default entirely.
NPATI_SANDBOX_ALLOWED_HOSTS=
# Hosts additionally allowed to use SSH (port 22). Everything else is limited to 80/443. This is a
# restriction only: a host must also be in the active phase allowlist to be reachable at all.
NPATI_SANDBOX_EGRESS_GIT_HOSTS=github.com,codeload.github.com,gitlab.com,bitbucket.org
NPATI_EGRESS_AUDIT_HOOK=

# Optional shared-runtime DEV Project API route. Empty values preserve public-only egress.
# NPATI_PROJECT_API_SANDBOX_URL=http://project-api.npati.internal
# NPATI_PROJECT_API_SERVICE_BINDING=dev
