NPATI_ENV=development
NPATI_AGENT_API_PORT=3001
NPATI_COMPANY_RUN_TIMEOUT_MS=120000
NPATI_COMPANY_WORKER_CONCURRENCY=2
NPATI_COMPANY_RUN_LEASE_MS=180000
NPATI_COMPANY_RECOVERY_INTERVAL_MS=30000
NPATI_WEB_PORT=3000
NPATI_WEB_ORIGIN=http://localhost:3000

# Central private object storage. Replace local-development values before deployment.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ROOT_USER=npati-local-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_ACCESS_KEY=npati-local-admin
MINIO_SECRET_KEY=replace-with-a-long-random-secret
MINIO_CONSOLE_PORT=9001
MINIO_OPERATION_TIMEOUT_MS=15000
MINIO_STREAM_IDLE_TIMEOUT_MS=30000
MINIO_STREAM_TOTAL_TIMEOUT_MS=300000
NPATI_STORAGE_RECONCILE_INTERVAL_MS=21600000
NPATI_STORAGE_ORPHAN_GRACE_MS=86400000
NPATI_STORAGE_RECONCILE_LEASE_MS=1800000
NPATI_STORAGE_RECONCILE_PAGE_SIZE=250

OMNIROUTE_BASE_URL=http://omniroute:20128
OMNIROUTE_API_KEY=npati-agent-internal-local
OMNIROUTE_MANAGEMENT_PASSWORD=
ARENA_ELO_SYNC_ENABLED=false
OMNIROUTE_TRANSCRIPTION_MODEL=openai/whisper-1
OMNIROUTE_TTS_MODEL=openai/gpt-4o-mini-tts
OMNIROUTE_EMBEDDING_MODEL=
OMNIROUTE_RERANK_MODEL=
# Configure one native OmniRoute rerank provider, then set OMNIROUTE_RERANK_MODEL.
JINA_AI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
OMNIROUTE_VISION_MODEL=openai/gpt-5.6-luna
OMNIROUTE_DASHBOARD_PORT=20128
OMNIROUTE_API_PORT=20129
OMNIROUTE_LIVE_WS_PORT=20132

NPATI_HUB_BASE_URL=
NPATI_HUB_API_KEY=
NPATI_BACKEND_URL=https://www.npati.com
NPATI_JWT_SECRET=
NPATI_AUTH_STRICT=true
NPATI_AGENT_PUBLIC_DOMAIN=http://localhost:3000
# Public HTTPS origin that routes /api/v1/integrations/telegram/* to agent-api.
# Telegram webhooks are configured automatically only when this value is set.
NPATI_MESSAGING_WEBHOOK_BASE_URL=
NPATI_AGENT_VERSION=0.1.0
NPATI_DEPLOYMENT_TYPE=self_hosted
# Official npati_hosted deployments only; never commit the real value.
NPATI_HOSTED_REGISTRATION_TOKEN=
# Compatibility only. Keep false for self-hosted installations so passwords are entered only on NPATI domains.
NPATI_ALLOW_LEGACY_PASSWORD_AUTH=false

CRAWL4AI_BASE_URL=http://crawler:11235
CRAWL4AI_VERSION=0.9.2
CRAWL4AI_API_TOKEN=replace-with-a-long-random-local-token
CRAWL4AI_SECRET_KEY=replace-with-a-long-random-local-secret
BROWSER_USE_API_KEY=
BROWSER_USE_MODEL=bu-2-0
NPATI_BROWSER_INTERNAL_TOKEN=replace-with-a-long-random-browser-worker-token
NPATI_BROWSER_MAX_RETRIES=2
NPATI_CRAWLER_PAGE_TIMEOUT_MS=45000

WEB_RESEARCH_MAX_SEARCH_RESULTS=10
WEB_RESEARCH_MAX_COMPETITORS=5
WEB_RESEARCH_MAX_PAGES_PER_SITE=10
WEB_RESEARCH_MAX_CRAWL_DEPTH=2
WEB_RESEARCH_TIMEOUT_SECONDS=45
WEB_RESEARCH_MAX_CONCURRENT_JOBS=2
WEB_RESEARCH_CACHE_TTL_SECONDS=600
WEB_RESEARCH_MAX_CONTENT_CHARACTERS=80000
WEB_RESEARCH_PER_DOMAIN_DELAY_MS=750

# Data Studio project databases.
# docker-compose.yml (local development): opt-in with "docker compose --profile data-studio up -d".
# docker-compose.dokploy.yml (single-host production): postgres-projects always starts, so only the
# password below is required.
# Generate a password with: openssl rand -hex 32
NPATI_PROJECTS_POSTGRES_ADMIN_USER=npati_projects_admin
NPATI_PROJECTS_POSTGRES_ADMIN_PASSWORD=
# Snapshots older than this are pruned; the same window delays the purge of a deleted DataBackend.
NPATI_PROJECTS_SNAPSHOT_RETENTION_DAYS=30
# Where pg_dump files are written. Mount this path on a separate volume in production.
NPATI_PROJECTS_SNAPSHOT_DIR=/app/project-snapshots
NPATI_DATA_MAX_COLLECTIONS=50
NPATI_DATA_MAX_FIELDS=100
NPATI_DATA_MAX_ROWS=100
NPATI_DATA_MAX_QUERIES_PER_MINUTE=600
NPATI_DATA_MAX_DATABASE_BYTES=1000000000
NPATI_DATA_MAX_CONNECTIONS=10
# Automatic backups: prod every 24h by default, dev disabled (0). The tick decides how often
# the scheduler checks whether a snapshot is due; set NPATI_DATA_BACKUP_DISABLED=true to stop it.
NPATI_DATA_BACKUP_INTERVAL_MINUTES=1440
NPATI_DATA_BACKUP_KEEP=7
NPATI_DATA_BACKUP_TICK_SECONDS=300
# Rows per collection copied when a promote explicitly asks for dev data (withData).
NPATI_PROMOTE_DATA_MAX_ROWS=500
# Public HTTPS base URL of the NPATI Project API, used by sandbox preview apps.
# Set the same dedicated host in NPATI_SANDBOX_ALLOWED_HOSTS on the sandbox runner.
NPATI_PROJECT_API_PUBLIC_URL=
# Optional: path to the Project client SDK source that is vendored into Project workspaces.
# The agent-api image ships it at /opt/npati-project-sdk/index.ts, which is the default.
NPATI_PROJECT_CLIENT_PATH=

# --- Coding Agent (C1) -------------------------------------------------------------------
# Code projects and code sessions exist, but the agent itself is dark until the feature-flag step
# (C1a). These limits are configuration with the plan defaults; override only to tune a deployment.
NPATI_CODE_MAX_STEPS=40
NPATI_CODE_MAX_RUN_MINUTES=30
NPATI_CODE_TOOL_OUTPUT_CHARS=30000
NPATI_CODE_READ_FILE_LINES=2000
NPATI_CODE_READ_FILE_BYTES=1048576
NPATI_CODE_COMMAND_TIMEOUT_MS=120000
NPATI_CODE_INSTALL_TIMEOUT_MS=600000
NPATI_CODE_PARALLEL_READONLY=8
NPATI_CODE_EDIT_REPAIR_ATTEMPTS=2
NPATI_CODE_REPAIR_LOOP=3
NPATI_CODE_CONTEXT_COMPRESSION_RATIO=0.75
NPATI_CODE_SUBAGENT_DEPTH=1
NPATI_CODE_SUBAGENT_PARALLELISM=4
NPATI_CODE_FLAG_PROPAGATION_SECONDS=30
NPATI_CODE_RUN_HEARTBEAT_MS=15000
NPATI_CODE_RUN_LEASE_MS=60000
NPATI_CODE_TOOL_NO_PROGRESS_MS=300000
NPATI_CODE_REAPER_INTERVAL_MS=60000
NPATI_CODE_MIN_PACKAGE_AGE_DAYS=7
NPATI_CODE_MAX_IMAGE_AGE_DAYS=14
NPATI_CODE_MAX_REDIRECTS=5
NPATI_CODE_TOOL_RESULT_RETENTION_DAYS=30
NPATI_CODE_TRANSCRIPT_RETENTION_DAYS=90

# --- Tamper-evident audit log (C1c) ------------------------------------------------------
# The journal is append-only (DB trigger) and hash-chained per company. Anchors are written daily to
# a signed file outside the Core database, so a full rewrite is still detectable.
NPATI_AUDIT_ANCHOR_DIR=
# Optional separate HMAC key for anchors; falls back to NPATI_ENCRYPTION_KEY.
NPATI_AUDIT_ANCHOR_KEY=
NPATI_AUDIT_VERIFY_INTERVAL_MS=21600000
NPATI_AUDIT_ANCHOR_INTERVAL_MS=3600000
# Retention of audit metadata (ids, hashes, redacted metadata only); R1 implements the pruning.
NPATI_AUDIT_RETENTION_DAYS=365
# When true (default) a detected chain break blocks new privileged audit writes until investigation.
NPATI_AUDIT_BLOCK_ON_BREAK=true
# Workspace used by background jobs (chain verifier, anchors) when there is no user context.
NPATI_WORKSPACE_ID=

# --- Coding Agent feature flags (C1a) ----------------------------------------------------
# The Coding Agent is dark by default: everything stays off until an owner/admin enables
# coding_agent.enabled (global or per company) in Settings -> Code -> Feature flags.
# Flag cache TTL in milliseconds; keep it at or below 30000 so a kill switch acts quickly.
NPATI_CODE_FLAG_CACHE_TTL_MS=15000
# Promoting a flag stage beyond "internal" (allowlist/percent/ga) is refused until G1 and R1 pass;
# set this to true only after those gates are signed off.
NPATI_ALLOW_PRE_GATE_ROLLOUT=false
# Automatically disable the Coding Agent globally when a security event is detected (for example a
# broken audit chain). The change is audited and the owner sees the new state in the UI.
NPATI_CODE_AUTO_DISABLE_ON_AUDIT_BREAK=true

# --- Sandbox image supply chain (C1b) ----------------------------------------------------
# Declarative image catalog: every sandbox image must be referenced as repo@sha256:<64hex>.
NPATI_SANDBOX_IMAGE_CATALOG=docker/sandbox/images.json
# Development only: allows locally built images. They stay "unverified" and are refused whenever a
# production flag is enabled for the company. Never enable this in production.
NPATI_SANDBOX_ALLOW_UNVERIFIED_IMAGES=false
# Optional seccomp profile passed to `docker run --security-opt seccomp=...`.
NPATI_SANDBOX_SECCOMP_PROFILE=
# cosign identity/issuer expected for a signed sandbox image; without them no signature verifier is
# configured and every image is denied (fail closed).
NPATI_SANDBOX_SIGNATURE_IDENTITY=
NPATI_SANDBOX_SIGNATURE_ISSUER=https://token.actions.githubusercontent.com
