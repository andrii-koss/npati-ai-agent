# Copy these values into the Dokploy Compose Environment editor.
# Use lowercase hexadecimal secrets to avoid URL and Compose escaping problems.
NPATI_WEB_ORIGIN=https://agent.example.com
NPATI_AGENT_PUBLIC_DOMAIN=https://agent.example.com
NPATI_BACKEND_URL=https://www.npati.com
NPATI_AGENT_VERSION=0.1.0
NPATI_DEPLOYMENT_TYPE=self_hosted
# Required only when NPATI_DEPLOYMENT_TYPE=npati_hosted (official ai.npati.com).
NPATI_HOSTED_REGISTRATION_TOKEN=

# Generate a different value for every line: openssl rand -hex 32
NPATI_POSTGRES_PASSWORD=replace_with_64_hex_characters
MINIO_ROOT_PASSWORD=replace_with_64_hex_characters
OMNIROUTE_API_KEY=replace_with_64_hex_characters
CRAWL4AI_API_TOKEN=replace_with_64_hex_characters
CRAWL4AI_SECRET_KEY=replace_with_64_hex_characters
NPATI_ENCRYPTION_KEY=replace_with_64_hex_characters
NPATI_REMOTE_ACCESS_TOKEN_SECRET=replace_with_64_hex_characters

NPATI_POSTGRES_USER=npati
NPATI_POSTGRES_DB=npati_agent
MINIO_ROOT_USER=npati-admin

# Optional integrations/providers
NPATI_HUB_BASE_URL=
NPATI_HUB_API_KEY=
OMNIROUTE_MANAGEMENT_PASSWORD=
JINA_AI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
OMNIROUTE_EMBEDDING_MODEL=
OMNIROUTE_RERANK_MODEL=
