# Copy these values into the Dokploy Compose Environment editor.
# Use lowercase hexadecimal secrets to avoid URL and Compose escaping problems.
NPATI_WEB_ORIGIN=https://agent.example.com
NPATI_AGENT_PUBLIC_DOMAIN=https://agent.example.com
NPATI_BACKEND_URL=https://www.npati.com
NPATI_AGENT_VERSION=0.1.0
# Set these from the deployed Git revision and build timestamp in Dokploy.
NPATI_BUILD_COMMIT=unknown
NPATI_BUILD_TIME=unknown
NPATI_TERMINAL_POLICY_LOG=true
# For Website Builder on the same Dokploy VPS, uncomment these lines.
# COMPOSE_PROFILES=local-sandbox
# NPATI_SANDBOX_RUNNER_MODE=local
# NPATI_SANDBOX_RUNNER_URL=http://sandbox-runner:7865
# NPATI_SANDBOX_RUNNER_SECRET=replace_with_64_hex_characters
# NPATI_PREVIEW_SECRET=replace_with_a_different_64_hex_character_secret
# docker-compose.dokploy-isolated.yml runs all sites inside sandbox-runner.
# No sandbox image registry, image overrides or signing variables are required.
# Optional host loopback port; Dokploy's domain still targets container port 3001.
# NPATI_AGENT_PUBLISHED_PORT=3001
NPATI_DEPLOYMENT_TYPE=self_hosted
# Required only when NPATI_DEPLOYMENT_TYPE=npati_hosted (official ai.npati.com).
NPATI_HOSTED_REGISTRATION_TOKEN=

# Generate a different value for every line: openssl rand -hex 32
NPATI_POSTGRES_PASSWORD=replace_with_64_hex_characters
MINIO_ROOT_PASSWORD=replace_with_64_hex_characters
OMNIROUTE_API_KEY=replace_with_64_hex_characters
CRAWL4AI_API_TOKEN=replace_with_64_hex_characters
CRAWL4AI_SECRET_KEY=replace_with_64_hex_characters
NPATI_ENCRYPTION_KEY=replace_with_64_hex_characters
NPATI_BROWSER_INTERNAL_TOKEN=replace_with_a_different_64_hex_character_secret
BROWSER_USE_API_KEY=replace_with_browser_use_api_key
BROWSER_USE_MODEL=bu-2-0
NPATI_BROWSER_MAX_RETRIES=2
NPATI_REMOTE_ACCESS_TOKEN_SECRET=replace_with_64_hex_characters

NPATI_POSTGRES_USER=npati
NPATI_POSTGRES_DB=npati_agent
MINIO_ROOT_USER=npati-admin
# Optional digest-pinned image from your own registry/mirror if Quay is unavailable.
# MINIO_IMAGE=your-registry/minio@sha256:your_verified_digest
# Optional API credentials for an existing MinIO user/service account.
# Set both values together; blank values fall back to the root credentials above.
# Setting these variables does not create the account in MinIO.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Set a strong OmniRoute management password before the first deployment.
# The same value is used by Agent API to manage provider connections.
OMNIROUTE_MANAGEMENT_PASSWORD=replace_with_a_strong_unique_password

# Optional integrations/providers
NPATI_HUB_BASE_URL=
NPATI_HUB_API_KEY=
JINA_AI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=
OMNIROUTE_EMBEDDING_MODEL=
OMNIROUTE_RERANK_MODEL=

# Required when enabling the data-studio Compose profile.
NPATI_PROJECTS_POSTGRES_ADMIN_USER=npati_projects_admin
NPATI_PROJECTS_POSTGRES_ADMIN_PASSWORD=replace_with_a_different_64_hex_character_secret
NPATI_PROJECTS_SNAPSHOT_RETENTION_DAYS=30
NPATI_DATA_MAX_COLLECTIONS=50
NPATI_DATA_MAX_FIELDS=100
NPATI_DATA_MAX_ROWS=100
NPATI_DATA_MAX_QUERIES_PER_MINUTE=600
NPATI_DATA_MAX_DATABASE_BYTES=1000000000
