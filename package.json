{
  "name": "npati-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Open Source AI Business Agent",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "catalog:generate": "node scripts/generate-omniroute-provider-catalog.mjs",
    "dev:web": "npm run dev --workspace @npati/web",
    "dev:api": "npm run dev --workspace @npati/agent-api",
    "build": "npm run catalog:generate && npm run build --workspace @npati/agent-api && npm run build --workspace @npati/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "node scripts/lint-guard.mjs && node scripts/scan-web-xss.mjs && node scripts/source-size-guard.mjs",
    "eval:smoke": "node node_modules/vitest/vitest.mjs run tests/coding-agent-c6-eval.test.ts --reporter=json --outputFile=artifacts/coding-agent-eval-smoke-report.json",
    "test": "vitest run",
    "test:known-failures": "node scripts/check-known-failures.mjs --artifact artifacts/known-failures-report.json",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:watch": "vitest",
    "test:stability": "vitest run tests/multi-provider-company-stability.test.ts tests/scale-certification-production.test.ts tests/phase12-scale-criteria.test.ts tests/production-p03-reliability-scale.test.ts",
    "test:email-stability": "vitest run tests/email-flood-stability-and-security.test.ts tests/email-ai-inbox.test.ts tests/email-messaging-gateway.test.ts tests/email-transport.test.ts",
    "audit:capabilities": "node scripts/verify-capability-matrix.mjs",
    "audit:code-tools": "node scripts/verify-code-tool-schemas.mjs --check",
    "audit:sandbox-images": "node scripts/sandbox-image-verify.mjs",
    "benchmark:scale": "node scripts/scale-benchmark.mjs",
    "cert:scale": "docker compose -f docker-compose.yml -f docker-compose.scale.yml run --rm scale-certifier",
    "cert:scale:smoke": "docker compose -f docker-compose.yml -f docker-compose.scale.yml run --rm scale-certifier node scripts/run-scale-certification.mjs --smoke",
    "cert:scale:up": "docker compose -f docker-compose.yml -f docker-compose.scale.yml up -d scale-api-a scale-api-b",
    "cert:scale:down": "docker compose -f docker-compose.yml -f docker-compose.scale.yml rm -s -f scale-api-a scale-api-b",
    "gate:upgrade": "node scripts/upgrade-gate.mjs",
    "gate:upgrade:db": "node scripts/upgrade-gate.mjs --db",
    "gate:agent": "tsx scripts/execute-agent-mediated-gate.mjs",
    "security-gate": "node scripts/run-security-gate.mjs",
    "security-gate:db": "node scripts/run-security-gate.mjs --db",
    "mutation:branch": "node scripts/security-gate-mutation-branch.mjs",
    "revalidate:306": "node scripts/revalidate-306-capabilities.mjs",
    "docker:config": "docker compose config --quiet",
    "postinstall": "node scripts/patch-minio-jsonl.mjs"
  },
  "engines": {
    "node": ">=22.22.2 <23 || >=24.0.0 <27"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "query-string": "9.5.1",
    "uuid": "11.1.1",
    "stream-json": "3.7.0"
  }
}
